/* app.wxss - 全局样式 */
page {
  background-color: #f8f9fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, 
              Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
  color: #333;
  line-height: 1.6;
}

/* 容器样式 */
.container {
  padding: 20rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 30rpx;
  overflow: hidden;
}

.card-header {
  padding: 24rpx 30rpx;
  background-color: #f8f9fa;
  border-bottom: 1rpx solid #eee;
  display: flex;
  align-items: center;
  font-weight: bold;
  font-size: 32rpx;
}

.card-header .icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
}

.card-body {
  padding: 30rpx;
}

/* 按钮样式 */
.btn {
  background-color: #1a73e8;
  color: white;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 30rpx;
  text-align: center;
  margin: 20rpx 0;
  transition: all 0.3s ease;
  display: inline-block;
}

.btn:active {
  background-color: #0d5cb6;
  transform: translateY(2rpx);
}

.btn-outline {
  background-color: transparent;
  border: 1rpx solid #1a73e8;
  color: #1a73e8;
}

.btn-outline:active {
  background-color: rgba(26, 115, 232, 0.1);
}

.btn-danger {
  background-color: #ff5252;
}

.btn-danger:active {
  background-color: #e04545;
}

/* 表单元素 */
input {
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #ddd;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

/* 状态指示器 */
.status-indicator {
  display: flex;
  align-items: center;
  padding: 15rpx 20rpx;
  border-radius: 12rpx;
  background-color: rgba(26, 115, 232, 0.1);
  margin-bottom: 20rpx;
}

.status-indicator .dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 15rpx;
}

.connected {
  background-color: #4CAF50;
}

.disconnected {
  background-color: #F44336;
}

/* 网格布局 */
.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin: 30rpx 0;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.grid-item image {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 15rpx;
}

.grid-item text {
  font-size: 26rpx;
  color: #666;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  background-color: rgba(26, 115, 232, 0.1);
  color: #1a73e8;
  border-radius: 8rpx;
  font-size: 24rpx;
  margin: 5rpx;
}