/* pages/emergency/emergency.wxss */
.emergency-container {
  padding-bottom: 100rpx;
}

.emergency-header {
  padding: 30rpx;
  background: linear-gradient(135deg, #ff5252, #ff7b7b);
  color: white;
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.emergency-content {
  padding: 0 20rpx;
}

.emergency-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.card-icon {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 20rpx;
  background-color: #ffebee;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-icon image {
  width: 60rpx;
  height: 60rpx;
}

.card-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.card-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.call-btn {
  background-color: #ff5252;
  color: white;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: inline-block;
}

.location-info {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
  display: block;
}

.location-detail {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
  padding: 20rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
}

.location-detail .icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 15rpx;
}

.share-btn {
  background-color: #1a73e8;
  color: white;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 30rpx;
  text-align: center;
  margin-top: 20rpx;
}

.history-section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.history-list {
  margin-top: 20rpx;
}

.history-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.history-item:last-child {
  border-bottom: none;
}

.history-item .type {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #ff5252;
}

.history-item .time {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin: 5rpx 0;
}

.history-item .location {
  display: block;
  font-size: 26rpx;
  color: #999;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 基础样式 */
.container {
  padding: 20rpx;
  min-height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background-color: #FF4D4F;
  color: white;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.warning-icon {
  width: 50rpx;
  height: 50rpx;
  margin-right: 20rpx;
}

/* 紧急项目列表 */
.emergency-list {
  margin-top: 20rpx;
}

.emergency-item {
  background: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.item-header {
  padding: 30rpx;
  display: flex;
  align-items: center;
}

.item-header image {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}

.item-header text {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
}

.arrow {
  width: 30rpx;
  height: 30rpx;
}

/* 弹窗样式 */
.modal-content {
  max-height: 60vh;
  overflow-y: auto;
  padding: 20rpx;
}

.step {
  margin-bottom: 30rpx;
}

.step-title {
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
  color: #FF4D4F;
}

.step-desc {
  display: block;
  color: #666;
  line-height: 1.6;
}

.modal-footer button {
  background-color: #FF4D4F;
  color: white;
  border-radius: 50rpx;
}