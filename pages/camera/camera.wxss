/* pages/camera/camera.wxss */
.camera-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.preview-container {
  flex: 1;
  position: relative;
  background-color: #000;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.camera-controls {
  position: absolute;
  bottom: 50rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  padding: 0 50rpx;
}

.capture-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 20rpx rgba(0,0,0,0.2);
}

.capture-btn::before {
  content: '';
  width: 80rpx;
  height: 80rpx;
  background-color: #ff5252;
  border-radius: 50%;
}

.switch-mode {
  background-color: rgba(255, 255, 255, 0.7);
  color: #333;
  padding: 15rpx 30rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
}

.result-container {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-image {
  flex: 1;
  background-color: #000;
}

.ai-analysis {
  padding: 30rpx;
  background-color: #fff;
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 1rpx solid #eee;
}

.analysis-header text {
  font-size: 32rpx;
  font-weight: bold;
}

.analysis-mode {
  font-size: 26rpx;
  color: #1a73e8;
  background-color: rgba(26, 115, 232, 0.1);
  padding: 5rpx 15rpx;
  border-radius: 8rpx;
}

.tags {
  margin: 20rpx 0;
}

.description {
  font-size: 28rpx;
  line-height: 1.6;
  color: #444;
  margin-top: 20rpx;
}

.action-buttons {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background-color: #fff;
  border-top: 1rpx solid #eee;
}

.action-buttons .btn {
  flex: 1;
  margin: 0 10rpx;
  text-align: center;
}

.retake {
  background-color: #f0f2f5;
  color: #333;
}

.enhance {
  background-color: #1a73e8;
  color: white;
}

.listen {
  background-color: #4CAF50;
  color: white;
}

.loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  z-index: 100;
}

.loading image {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 30rpx;
}