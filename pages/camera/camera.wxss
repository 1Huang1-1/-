
/* pages/camera/camera.wxss */
.container {
  position: relative;
  min-height: 100vh;
  padding: 20rpx;
  background-color: #f5f5f7;
}

/* 权限提示 */
.permission-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 20rpx;
  background-color: #fff8e1;
  border-radius: 16rpx;
  margin: 30rpx 0;
}

.permission-tip icon {
  margin-right: 15rpx;
  color: #ff9800;
}

.grant-btn {
  margin-left: 20rpx;
  padding: 8rpx 20rpx;
  background-color: #1a73e8;
  color: white;
  border-radius: 30rpx;
  font-size: 24rpx;
}

/* 相册样式 */
.album-container {
  margin-bottom: 120rpx; /* 留出底部按钮空间 */
}

.album-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.album-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.album-count {
  font-size: 26rpx;
  color: #999;
}

.album-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 15rpx;
}

.album-item {
  position: relative;
  width: 32%;
  padding-top: 32%; /* 正方形比例 */
  border-radius: 12rpx;
  overflow: hidden;
}

.album-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.delete-icon {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s;
}

.album-item:hover .delete-icon {
  opacity: 1;
}

.empty-album {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-album icon {
  margin-bottom: 30rpx;
}

.empty-album text {
  margin-bottom: 10rpx;
  font-size: 28rpx;
}

/* 底部拍照按钮 */
.take-photo-fab {
  position: relative;
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #1a73e8;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(26, 115, 232, 0.4);
  z-index: 50;
}

.fab-add-image {
  color: #000;
  position: absolute;
  width: 120rpx; /* 和按钮同宽高，覆盖按钮 */
  height: 120rpx;
  left: 0;
  top: 0;
  opacity: 0.5;
}

/* 相机弹窗 */
.camera-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #000;
  z-index: 100;
}

.camera-header {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  color: white;
}

.close-btn {
  position: absolute; /* 改为绝对定位 */
  left: 30rpx; /* 紧贴左侧 */
  top: 30rpx; /* 紧贴顶部 */
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  padding: 0;
  z-index: 10; /* 确保在顶部 */
}
.clsoe-add-image {
  position: absolute;
  width: 100%; /* 覆盖整个快门 */
  height: 100%;
  left: 0;
  top: 0;
  opacity: 0.8;
}

.camera-title {
  font-size: 32rpx;
  font-weight: bold;
  position: absolute; /* 绝对定位居中 */
  left: 50%;
  transform: translateX(-50%);
}

.camera-actions {
  position: absolute; /* 改为绝对定位 */
  right: 30rpx; /* 紧贴右侧 */
  top: 30rpx; /* 紧贴顶部 */
  z-index: 10; /* 确保在顶部 */
}

.switch-camera {
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  padding: 0;
  position: relative;
}

.flash-btn {
  width: 60rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  padding: 0;
}

.switch-add-image {
  position: absolute;
  width: 20rpx; 
  height: 20rpx;
  right: -5rpx; /* 调整位置，贴在按钮角落 */
  top: -5rpx;
}

.camera-preview {
  width: 100%;
  height: calc(100% - 280rpx);
  display: block;
}

.camera-controls {
  position: absolute;
  bottom: 60rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between; /* 左右分散对齐 */
  align-items: center;
  padding: 0 60rpx; /* 左右留出空间 */
  z-index: 10;
}

.take-photo-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.shutter {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #f44336;
  border: 4rpx solid white;
}

.shutter-add-image {
  position: absolute;
  width: 100%; /* 覆盖整个快门 */
  height: 100%;
  left: 0;
  top: 0;
  opacity: 0.8;
}

.album-btn {
  position: absolute;
  right: 60rpx; /* 向右移动 */
  bottom: 70rpx; /* 向上移动 */
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  padding: 0;
}

/* 图片预览弹窗 */
.preview-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #000;
  z-index: 100;
  display: flex;
  flex-direction: column;
}

.preview-image {
  flex: 1;
  width: 100%;
  display: block;
}

.preview-actions {
  display: flex;
  justify-content: space-around;
  padding: 30rpx;
  background-color: rgba(0, 0, 0, 0.7);
}

.preview-btn {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  padding: 0;
}

.delete-btn {
  background-color: rgba(244, 67, 54, 0.7);
}

.save-btn {
  background-color: rgba(76, 175, 80, 0.7);
}

.recognize-btn {
  background-color: rgba(33, 150, 243, 0.7);
}

/* 识别结果弹窗 */
.result-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  padding: 20rpx;
  z-index: 110;
  max-height: 60vh;
  overflow-y: auto;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.close-result {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.result-content {
  padding: 10rpx 0;
}

.spot-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #1a73e8;
  display: block;
  margin-bottom: 15rpx;
}

.spot-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.no-result {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  padding: 20rpx 0;
}

.play-voice-btn {
  width: 100%;
  background-color: #1a73e8;
  color: white;
  border-radius: 8rpx;
  padding: 15rpx 0;
  font-size: 28rpx;
  margin-top: 10rpx;
}


