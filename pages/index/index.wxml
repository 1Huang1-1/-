<!-- pages/index/index.wxml -->
<view class="page-container">
  <!-- 顶部状态栏 -->
  <view class="status-bar">
    <image src="/images/atoms3r-logo.png" class="logo"></image>
    <view class="location-info">
      <image src="/images/location.png" class="icon"></image>
      <text>{{locationInfo || '正在定位...'}}</text>
    </view>
    <view class="weather-info">
      <image src="/images/weather.png" class="icon"></image>
      <text>{{weather.temp}}°C | {{weather.weather}}</text>
    </view>
  </view>
  
  <!-- 健康监测卡片 -->
  <sensor-card 
    temperature="{{healthData.temperature}}" 
    humidity="{{healthData.humidity}}" 
    bloodOxygen="{{healthData.bloodOxygen}}"
    connected="{{atomConnected}}"
  ></sensor-card>
  
  <!-- 天气预报卡片 -->
  <weather-card 
    weather="{{weather.weather}}" 
    temp="{{weather.temp}}" 
    humidity="{{weather.humidity}}" 
    wind="{{weather.wind}}"
  ></weather-card>
  
  <!-- 功能区域 -->
  <view class="function-grid">
    <view class="grid-item" bindtap="startNavigation">
      <image src="/images/navigation.png"></image>
      <text>景点导航</text>
    </view>
    <view class="grid-item" bindtap="navigateToCamera">
      <image src="/images/camera.png"></image>
      <text>拍照分析</text>
    </view>
    <view class="grid-item" bindtap="aiAssistant">
      <image src="/images/ai-assistant.png"></image>
      <text>AI助手</text>
    </view>
    <view class="grid-item" bindtap="navigateToEmergency">
      <image src="/images/emergency.png"></image>
      <text>紧急求助</text>
    </view>
  </view>
  
  <!-- 景点推荐 -->
  <view class="attraction-section">
    <view class="section-header">
      <text>附近景点推荐</text>
      <view class="more-link" bindtap="viewMoreAttractions">查看更多</view>
    </view>
    <scroll-view class="attraction-list" scroll-x="true">
      <block wx:for="{{attractions}}" wx:key="id">
        <attraction-item 
          id="{{item.id}}"
          name="{{item.name}}"
          image="{{item.image}}"
          distance="{{item.distance}}"
          rating="{{item.rating}}"
          bindtap="viewAttractionDetail"
        ></attraction-item>
      </block>
    </scroll-view>
  </view>
  
  <!-- AI助手浮窗 -->
  <view class="ai-assistant-float" bindtap="openAIChat">
    <image src="/images/ai-assistant.png"></image>
    <button bindtap="handleOpenAIChat">AI旅行助手</button>
  </view>

<!-- 语音交互状态展示（可选） -->
<view class="status-panel" wx:if="{{isListening || isPlaying}}">
  <text wx:if="{{isListening}}">正在录音，请说话...</text>
  <text wx:if="{{isPlaying}}">正在播放智能体回复...</text>
</view>

  <!-- 大标题 -->
  <view class="artistic-container">
    <text class="main-text">青崖引</text>
    <text class="sub-text">您的专属安心管家</text>
  </view>
  <view class="travel-diary-container">
  <!-- 标题栏 -->
  <view class="header">
    <text class="title">旅游日志</text>
  </view>
  
  <!-- 日志列表 -->
  <view class="diary-list">
    <block wx:for="{{diaries}}" wx:key="id">
      <view class="diary-item" style="border-color: {{item.isEditing ? '#ddd' : '#f8e685'}}">
        <!-- 日志内容（编辑状态显示输入框，否则显示文本） -->
        <textarea 
          class="diary-content" 
          value="{{item.content}}" 
          bindinput="onContentInput" 
          data-id="{{item.id}}"
          disabled="{{!item.isEditing}}"
        ></textarea>
        
        <view class="diary-meta">
          <!-- 时间地点信息 -->
          <text class="meta-text">{{item.date}} · {{item.location}}</text>
          
          <!-- 操作按钮 -->
          <view class="btn-group">
            <button 
              size="mini" 
              class="edit-btn" 
              bindtap="toggleEdit" 
              data-id="{{item.id}}"
              data-action="edit"
            >
              {{item.isEditing ? '完成' : '编辑'}}
            </button>
            <button 
              size="mini" 
              class="delete-btn" 
              bindtap="deleteDiary" 
              data-id="{{item.id}}"
            >删除</button>
          </view>
        </view>
      </view>
    </block>
  </view>
  
  <!-- 添加新日志按钮 -->
  <button class="add-btn" bindtap="addDiary">添加新日志</button>
  </view>
</view>
