/* pages/index/index.wxss */
.index-container {
  padding-bottom: 100rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #1a73e8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-weight: bold;
  font-size: 36rpx;
}

.location-info {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.location-info .icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.weather-info {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.weather-info .icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin: 30rpx 0;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  transition: all 0.3s ease;
}

.grid-item:active {
  transform: translateY(5rpx);
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.1);
}

.grid-item image {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.grid-item text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.attraction-section {
  margin-top: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.section-header text {
  font-size: 32rpx;
  font-weight: bold;
}

.more-link {
  font-size: 26rpx;
  color: #1a73e8;
}

.attraction-list {
  display: flex;
  overflow-x: auto;
  padding: 10rpx 0;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.attraction-list::-webkit-scrollbar {
  display: none;
}

.attraction-item {
  width: 280rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.attraction-item image {
  width: 100%;
  height: 180rpx;
  display: block;
}

.attraction-item text {
  display: block;
  padding: 15rpx;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.attraction-item .distance {
  display: block;
  padding: 0 15rpx 15rpx;
  font-size: 24rpx;
  color: #666;
}

.ai-assistant-float {
  position: fixed;
  bottom: 200rpx;
  right: 30rpx;
  background-color: #1a73e8;
  color: white;
  padding: 20rpx 25rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(26, 115, 232, 0.3);
  z-index: 100;
}

.ai-assistant-float image {
  width: 50rpx;
  height: 50rpx;
  margin-right: 10rpx;
}