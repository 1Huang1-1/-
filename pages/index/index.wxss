/* pages/index/index.wxss */
.index-container {
  padding-bottom: 100rpx;
}

.status-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #1a73e8;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-weight: bold;
  font-size: 36rpx;
}

.location-info {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.location-info .icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.weather-info {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.weather-info .icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin: 30rpx 0;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  transition: all 0.3s ease;
}

.grid-item:active {
  transform: translateY(5rpx);
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.1);
}

.grid-item image {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.grid-item text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.attraction-section {
  margin-top: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.section-header text {
  font-size: 32rpx;
  font-weight: bold;
}

.more-link {
  font-size: 26rpx;
  color: #1a73e8;
}

.attraction-list {
  display: flex;
  overflow-x: auto;
  padding: 10rpx 0;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.attraction-list::-webkit-scrollbar {
  display: none;
}

.attraction-item {
  width: 280rpx;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.attraction-item image {
  width: 100%;
  height: 180rpx;
  display: block;
}

.attraction-item text {
  display: block;
  padding: 15rpx;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.attraction-item .distance {
  display: block;
  padding: 0 15rpx 15rpx;
  font-size: 24rpx;
  color: #666;
}

.ai-assistant-float {
  position: fixed;
  bottom: 200rpx;
  right: 30rpx;
  background-color: #1a73e8;
  color: white;
  padding: 20rpx 25rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(26, 115, 232, 0.3);
  z-index: 100;
}

.ai-assistant-float image {
  width: 50rpx;
  height: 50rpx;
  margin-right: 10rpx;
}
/* 页面整体样式 */
page {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #f5f5f5;
}

/* 艺术字容器 - 占据左上角四分之一区域 */
.artistic-container {
  position: absolute;
  top:10 ;
  left: 0;
  width: 50%;
  height: 50%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-left: 20rpx; /* 左侧边距，适配小程序rpx单位 */
  box-sizing: border-box;
}

/* 主标题样式 */
.main-text {
  font-size: 80rpx; /* 大字体，使用rpx适配不同屏幕 */
  font-weight: bold;
  background: linear-gradient(to right, #0f4c3f, #00b4d8); /* 深绿到青绿色渐变 */
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin: 0;
  line-height: 1.2;
}

/* 副标题样式 */
.sub-text {
  font-size: 32rpx; /* 较小字体 */
  background: linear-gradient(to right, #0f4c3f, #00b4d8); /* 相同渐变颜色 */
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-top: 20rpx;
}
/* 整体容器样式 */
.travel-diary-container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 标题栏样式 */
.header {
  text-align: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

/* 日志列表样式 */
.diary-list {
  margin-bottom: 20rpx;
}

/* 日志项样式（淡黄色边框） */
.diary-item {
  border: 2rpx solid #f8e685; /* 淡黄色边框 */
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05); /* 轻微阴影效果 */
}

/* 日志内容输入框样式 */
.diary-content {
  position:relative;
  width: 100%;
  min-height: 120rpx;
  border: none;
  font-size: 32rpx;                                                          
  margin-bottom: 16rpx;
  padding: 12rpx;
  box-sizing: border-box;
  background-color: #f9f9f9; /* 浅灰色背景区分输入区域 */
  border-radius: 8rpx;
}

/* 日志元信息（时间+地点）样式 */
.diary-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #888; /* 灰色小字体 */
  margin-top: 10rpx;
}

.meta-text {
  max-width: 70%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 操作按钮组样式 */
.btn-group {
  display: flex;
  gap: 10rpx; /* 按钮间距 */
}

.edit-btn {
  padding: 4rpx 16rpx;
  background-color: #409EFF; /* 蓝色编辑按钮 */
  color: #fff;
  border-radius: 4rpx;
  font-size: 24rpx;
  height: 40rpx;
  line-height: 1.5;
}

.delete-btn {
  position:absolute;
  top:0;
  right:0;
  padding: 4rpx 16rpx;
  background-color: #E64340; /* 红色删除按钮 */
  color: #fff;
  border-radius: 4rpx;
  font-size: 24rpx;
  height: 40rpx;
  line-height: 1.5;
  transform:translateY(-50%);
}

/* 图片上传区域样式 */
.image-container {
  margin-top: 16rpx;
}

.image-list {
  display: flex;
  gap: 10rpx;
}

.image-list image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

.add-image-btn {
  margin-top: 10rpx;
  padding: 8rpx 20rpx;
  background-color: #f0f0f0;
  color: #666;
  font-size: 28rpx;
  border: none;
  border-radius: 6rpx;
}

/* 添加新日志按钮样式（悬浮在右下角） */
.add-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #409EFF; /* 蓝色按钮 */
  color: #fff;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 48rpx;
  box-shadow: 0 4rpx 16rpx rgba(64, 158, 255, 0.3); /* 阴影效果 */
  z-index: 100; /* 确保按钮在最上层 */
}